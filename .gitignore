# macOS
.DS_Store

# scratch / sketch artifacts
scraps/
*.napkin

# stray uploads excluded from public repo
**/uploads/Untitled*.pdf
**/uploads/*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].pdf

# UI simplicity per-run output (baseline.json IS committed; report.json isn't)
**/eval/ui-simplicity/report.json
**/eval/ui-simplicity/.last-run

# Corpus — raw originals + per-file extracted text are gitignored.
# manifest.json + index/bm25.json ARE committed (small, no PII risk for the
# current public-record set; flip per-doc classification in manifest if a
# privileged matter is staged).
**/corpus/raw/
**/corpus/extracted/

# Python venvs (subdir bin/dev creates one)
**/.venv/

# env / secrets (defense-in-depth; subdir .gitignore also covers)
.env
.env.*
!.env.example
*.pem
*.key

# python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# node / web
node_modules/
dist/
.vite/
.next/

# logs / scratch
*.log
scratch/
