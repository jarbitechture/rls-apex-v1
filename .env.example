# ─────────────────────────────────────────────────────────────────────────────
# RLS Apex v1 — environment template
# Real values come from Azure Key Vault on llm01; this file is for local dev.
# Never commit a populated .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Auth allowlist ───────────────────────────────────────────────────────────
# Comma-separated UPNs (or DOMAIN\sam-style strings) allowed to enter the app.
# Empty = no allowlist (open to anyone who passes OIDC). Same gate runs in
# DEV_AUTH_BYPASS mode (against the synthetic dev user) and in production
# (against the upn extracted from the Entra ID token).
#   v0.1.0 baseline:  RLS_ALLOWLIST=BCC\ejarbeadm
RLS_ALLOWLIST=

# Synthetic dev user upn — consulted only when DEV_AUTH_BYPASS=1.
# Set this to the allowlisted user (e.g. BCC\ejarbeadm) so the dev session
# represents that account.
DEV_USER_UPN=dev@local

# ── Entra ID OIDC (gateway) ──────────────────────────────────────────────────
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=                           # confidential client; KV in prod
OIDC_AUTHORITY=https://login.microsoftonline.com/${AZURE_TENANT_ID}/v2.0
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback
OIDC_AUDIENCE=api://rls-apex-v1

# ── State (bcc-db-llm01 in prod) ─────────────────────────────────────────────
PG_DSN=postgresql://rls:rls@localhost:5432/rls_apex
PG_AGE_GRAPH=rls_policy_graph
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_DOCS=rls-docs

# ── LLM (multi-provider seam — apps/gateway/llm/client.py) ───────────────────
# Provider selection:
#   LLM_PROVIDER=auto    → first reachable: sglang > ollama > openai > mock
#   LLM_PROVIDER=mock    → canned text from the agent script's answer template
#   LLM_PROVIDER=ollama  → local Qwen via Ollama (laptop dev)
#   LLM_PROVIDER=sglang  → SGLang/Qwen2.5-14B-FP8 on bcc-ap-infer01 (prod)
#   LLM_PROVIDER=openai  → cold-start fallback (county egress allowlist required)
LLM_PROVIDER=mock                              # flip to 'auto' once an LLM is reachable
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.2
LLM_REQUEST_TIMEOUT=30

# Ollama (laptop dev — qwen2.5:3b ~1.8GB)
#   Bring-up:
#     OLLAMA_MODELS="$HOME/.ollama-models" ollama serve
#     OLLAMA_MODELS="$HOME/.ollama-models" ollama pull qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# SGLang (prod — bcc-ap-infer01, OpenAI-compatible /v1/chat/completions)
SGLANG_BASE_URL=http://bcc-ap-infer01:30000/v1
SGLANG_MODEL=qwen2.5-14b-instruct-fp8

# OpenAI (cold-start fallback only; disabled by default in v0.1.0)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── MCP tools (loopback, RS256 JWT) ──────────────────────────────────────────
MCP_JWT_PRIVATE_KEY_PATH=./secrets/mcp-jwt-private.pem
MCP_JWT_PUBLIC_KEY_PATH=./secrets/mcp-jwt-public.pem
MCP_TOOL_RETRIEVE_URL=http://127.0.0.1:30100
MCP_TOOL_POLICY_GRAPH_URL=http://127.0.0.1:30101
MCP_TOOL_ONTOLOGY_URL=http://127.0.0.1:30102
MCP_TOOL_LINEAGE_URL=http://127.0.0.1:30103
MCP_TOOL_DOCS_URL=http://127.0.0.1:30104
MCP_TOOL_REPORT_ROI_URL=http://127.0.0.1:30105

# ── Observability ────────────────────────────────────────────────────────────
PHOENIX_ENDPOINT=http://localhost:6006
ROI_SIDECAR_PATH=/var/log/manatee_ai_roi/rls-apex-v1.jsonl

# ── Feature flags ────────────────────────────────────────────────────────────
RLS_ENV=dev                                    # dev | staging | prod
RLS_VERSION=0.1.0
