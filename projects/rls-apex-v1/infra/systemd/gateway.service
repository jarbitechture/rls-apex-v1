[Unit]
Description=RLS Apex v1 — FastAPI gateway
After=network-online.target mcp-tool@retrieve.service
Wants=network-online.target
PartOf=rls-apex.target

[Service]
Type=notify
User=rls-apex
Group=rls-apex
WorkingDirectory=/opt/rls-apex-v1/apps/gateway

EnvironmentFile=/etc/rls-apex/gateway.env
Environment=PYTHONUNBUFFERED=1

ExecStart=/opt/rls-apex-v1/.venv/bin/uvicorn gateway.main:app \
  --host 0.0.0.0 \
  --port 8080 \
  --workers 4 \
  --proxy-headers \
  --forwarded-allow-ips '127.0.0.1'

ExecReload=/bin/kill -HUP $MAINPID

Restart=on-failure
RestartSec=3s

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rls-apex /var/log/rls-apex

MemoryMax=4G
CPUQuota=400%

StandardOutput=journal
StandardError=journal
SyslogIdentifier=rls-apex-gateway

[Install]
WantedBy=rls-apex.target
