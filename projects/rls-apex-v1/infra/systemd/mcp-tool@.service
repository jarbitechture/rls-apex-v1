[Unit]
Description=RLS Apex v1 — MCP tool: %i
Documentation=https://github.com/jarbitechture/rls-apex-v1/blob/main/ARCHITECTURE.md
After=network-online.target
Wants=network-online.target
PartOf=rls-apex.target

[Service]
Type=notify
User=rls-apex
Group=rls-apex
WorkingDirectory=/opt/rls-apex-v1/mcp-tools/%i

# Each tool pulls its own KV secret at boot (least privilege)
EnvironmentFile=/etc/rls-apex/mcp-tool@%i.env
Environment=PYTHONUNBUFFERED=1
Environment=MCP_TOOL_NAME=%i
Environment=MCP_TOOL_AUDIENCE=tool.%i

# Loopback only — never bind to a routable interface
Environment=MCP_BIND=127.0.0.1

ExecStartPre=/opt/rls-apex-v1/bin/preflight.sh %i
ExecStart=/opt/rls-apex-v1/.venv/bin/python -m mcp_tools.%i.server
ExecReload=/bin/kill -HUP $MAINPID

# Per Operating Rule #19 — circuit breakers wrap external calls inside the process
# systemd handles process-level supervision: restart with backoff
Restart=on-failure
RestartSec=2s
StartLimitIntervalSec=60s
StartLimitBurst=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rls-apex/%i /var/log/rls-apex
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Only loopback, no public network
IPAddressDeny=any
IPAddressAllow=localhost

# Resource caps so a runaway tool can't starve siblings
MemoryMax=2G
CPUQuota=200%
TasksMax=512

# Logs go to journald, then forwarded to Phoenix via the audit shipper
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mcp-tool-%i

[Install]
WantedBy=rls-apex.target
