{
  "version": 2,
  "viewport": { "width": 1440, "height": 900 },
  "regression_threshold": 5,
  "metrics": [
    { "key": "interactiveAboveFold", "label": "Interactive above fold",   "soft": 25,   "hard": 50,   "penalty": 1.5 },
    { "key": "fontSizes",            "label": "Distinct font sizes",       "soft":  8,   "hard": 14,   "penalty": 3.0 },
    { "key": "colors",               "label": "Distinct text colors",      "soft": 18,   "hard": 30,   "penalty": 2.0 },
    { "key": "panels",               "label": "Open panels/overlays",      "soft":  2,   "hard":  4,   "penalty": 8.0 },
    { "key": "kpiCards",             "label": "Visible KPI cards",         "soft":  9,   "hard": 14,   "penalty": 4.0 },
    { "key": "aiWidgets",            "label": "Visible AI widgets",        "soft":  1,   "hard":  2,   "penalty": 10.0 },
    { "key": "density",              "label": "Element density (per kpx²)", "soft": 0.05, "hard": 0.10, "penalty": 35.0, "perUnit": 0.01 }
  ]
}
