# ─────────────────────────────────────────────────────────────────────────────
# RLS Apex v1 — environment template
# Real values come from Azure Key Vault on llm01; this file is for local dev.
# Never commit a populated .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Entra ID OIDC (gateway) ──────────────────────────────────────────────────
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=                           # confidential client; KV in prod
OIDC_AUTHORITY=https://login.microsoftonline.com/${AZURE_TENANT_ID}/v2.0
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback
OIDC_AUDIENCE=api://rls-apex-v1

# ── State (bcc-db-llm01 in prod) ─────────────────────────────────────────────
PG_DSN=postgresql://rls:rls@localhost:5432/rls_apex
PG_AGE_GRAPH=rls_policy_graph
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_DOCS=rls-docs

# ── Inference ────────────────────────────────────────────────────────────────
SGLANG_BASE_URL=http://bcc-ap-infer01:30000/v1
SGLANG_MODEL=qwen2.5-14b-instruct-fp8
OPENAI_API_KEY=                                # cold-start fallback only
OPENAI_MODEL=gpt-4o-mini

# ── MCP tools (loopback, RS256 JWT) ──────────────────────────────────────────
MCP_JWT_PRIVATE_KEY_PATH=./secrets/mcp-jwt-private.pem
MCP_JWT_PUBLIC_KEY_PATH=./secrets/mcp-jwt-public.pem
MCP_TOOL_RETRIEVE_URL=http://127.0.0.1:30100
MCP_TOOL_POLICY_GRAPH_URL=http://127.0.0.1:30101
MCP_TOOL_ONTOLOGY_URL=http://127.0.0.1:30102
MCP_TOOL_LINEAGE_URL=http://127.0.0.1:30103
MCP_TOOL_DOCS_URL=http://127.0.0.1:30104
MCP_TOOL_REPORT_ROI_URL=http://127.0.0.1:30105

# ── Observability ────────────────────────────────────────────────────────────
PHOENIX_ENDPOINT=http://localhost:6006
ROI_SIDECAR_PATH=/var/log/manatee_ai_roi/rls-apex-v1.jsonl

# ── Feature flags ────────────────────────────────────────────────────────────
RLS_ENV=dev                                    # dev | staging | prod
RLS_VERSION=0.1.0
